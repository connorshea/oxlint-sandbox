{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true
  },
  "plugins": ["typescript"],
  "rules": {
    "typescript/no-floating-promises": [
      "error",
      {
        "allowForKnownSafePromises": [
          { "from": "file", "name": "MyPromise" }
        ]
      }
    ]
  }
}
