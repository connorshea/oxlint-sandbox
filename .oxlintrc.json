{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript"
  ],
  "categories": {
    "correctness": "off"
  },
  "env": {
    "builtin": true
  },
  "rules": {},
  "overrides": [
    {
      "files": [
        "**/*.ts"
      ],
      "rules": {
        "typescript/array-type": "error"
      }
    }
  ]
}